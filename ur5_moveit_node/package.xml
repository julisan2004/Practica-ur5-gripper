<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5_moveit_node</name>
  <version>0.1.0</version>
  <description>Nodo que ejecuta trayectorias en el UR5 con gripper usando MoveIt 2</description>
  <maintainer email="juan@todo.todo">Juan Jose Cadena Moreno</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <exec_depend>ur5_robotiq_moveit</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
